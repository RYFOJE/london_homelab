{
  "uid": "lab-alloy-health",
  "title": "Telemetry Pipeline Health",
  "description": "Is the observability stack itself working? Answers 'why are my logs missing' before you go looking in the wrong place.",
  "tags": ["lab", "alloy", "meta"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Collection (Alloy)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Components running",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(alloy_component_controller_running_components)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Components unhealthy",
      "description": "Anything above zero means part of the pipeline is silently not running.",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(alloy_component_controller_running_components{health_type!=\"healthy\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Log lines sent /s",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 1, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(loki_write_sent_entries_total[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Log lines dropped /s",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 0.01 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(loki_write_dropped_entries_total[$__rate_interval])) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Files tailed",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(loki_source_file_files_active_total) or vector(0)"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Alloy restarts (24h)",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(increase(kube_pod_container_status_restarts_total{namespace=\"observability\", container=\"alloy\"}[24h])) or vector(0)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Log throughput: sent vs dropped",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "dropped" },
            "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
          }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(loki_write_sent_entries_total[$__rate_interval]))",
          "legendFormat": "sent"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(loki_write_dropped_entries_total[$__rate_interval])) or vector(0)",
          "legendFormat": "dropped"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(loki_write_batch_retries_total[$__rate_interval])) or vector(0)",
          "legendFormat": "retries"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "OTLP received (spans / logs / metric points)",
      "description": "Zero here with instrumented apps running means the app isn't reaching Alloy — check OTEL_EXPORTER_OTLP_ENDPOINT.",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(otelcol_receiver_accepted_spans_total[$__rate_interval])) or vector(0)",
          "legendFormat": "spans accepted"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(otelcol_receiver_accepted_log_records_total[$__rate_interval])) or vector(0)",
          "legendFormat": "log records accepted"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(otelcol_receiver_accepted_metric_points_total[$__rate_interval])) or vector(0)",
          "legendFormat": "metric points accepted"
        },
        {
          "refId": "D",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(otelcol_receiver_refused_spans_total[$__rate_interval])) or vector(0)",
          "legendFormat": "spans REFUSED"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "OTLP export failures",
      "description": "Anything non-zero means telemetry is being thrown away downstream of Alloy.",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 0, "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(otelcol_exporter_send_failed_spans_total[$__rate_interval])) or vector(0)",
          "legendFormat": "spans failed"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(otelcol_exporter_send_failed_log_records_total[$__rate_interval])) or vector(0)",
          "legendFormat": "logs failed"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(otelcol_exporter_send_failed_metric_points_total[$__rate_interval])) or vector(0)",
          "legendFormat": "metrics failed"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Remote write to Prometheus",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(prometheus_remote_storage_samples_total{job=~\".*alloy.*\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "samples sent"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(prometheus_remote_storage_samples_failed_total{job=~\".*alloy.*\"}[$__rate_interval])) or vector(0)",
          "legendFormat": "samples failed"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(prometheus_remote_storage_samples_pending{job=~\".*alloy.*\"}) or vector(0)",
          "legendFormat": "pending in queue"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Storage (the thing that fills up a single node)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "bargauge",
      "title": "Observability PVC usage",
      "description": "local-path PVCs all share the node's disk. When this fills, Prometheus and Loki both stop writing.",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "options": {
        "displayMode": "gradient",
        "orientation": "horizontal",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "showUnfilled": true
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 75 },
              { "color": "red", "value": 90 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "100 * (1 - kubelet_volume_stats_available_bytes{namespace=\"observability\"} / kubelet_volume_stats_capacity_bytes{namespace=\"observability\"})",
          "legendFormat": "{{persistentvolumeclaim}}",
          "instant": true
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Ingestion volume by namespace (Loki)",
      "description": "Which namespace is eating the disk.",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 20, "stacking": { "mode": "normal", "group": "A" }, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(loki_distributor_bytes_received_total[$__rate_interval])) or vector(0)",
          "legendFormat": "loki ingest"
        }
      ]
    }
  ]
}
