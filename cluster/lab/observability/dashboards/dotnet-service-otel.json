{
  "uid": "lab-dotnet-otel",
  "title": ".NET Service (OpenTelemetry)",
  "description": "RED metrics, runtime health, traces and logs for any service exporting OTLP to Alloy. Works with zero custom instrumentation — the built-in ASP.NET Core and runtime meters plus Tempo's span metrics cover everything here.",
  "tags": ["lab", "applications", "otel", "dotnet"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "graphTooltip": 1,
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      {
        "name": "prometheus",
        "label": "Metrics",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "loki",
        "label": "Logs",
        "type": "datasource",
        "query": "loki",
        "current": {},
        "hide": 0
      },
      {
        "name": "job",
        "label": "Service",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${prometheus}" },
        "query": "label_values(http_server_request_duration_seconds_count, job)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "current": {}
      },
      {
        "name": "route",
        "label": "Route",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${prometheus}" },
        "query": "label_values(http_server_request_duration_seconds_count{job=\"$job\"}, http_route)",
        "refresh": 2,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": { "text": "All", "value": "$__all" }
      }
    ]
  },
  "panels": [
    {
      "id": 100,
      "type": "row",
      "title": "Request health (RED)",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 1,
      "type": "stat",
      "title": "Requests / sec",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 5, "w": 4, "x": 0, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "decimals": 2, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(rate(http_server_request_duration_seconds_count{job=\"$job\", http_route=~\"$route\"}[$__rate_interval]))"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Error rate",
      "description": "5xx responses as a share of all responses.",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 5, "w": 4, "x": 4, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "background",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "orange", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "100 * sum(rate(http_server_request_duration_seconds_count{job=\"$job\", http_route=~\"$route\", http_response_status_code=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_request_duration_seconds_count{job=\"$job\", http_route=~\"$route\"}[$__rate_interval])), 0.001)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "p95 latency",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 5, "w": 4, "x": 8, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "decimals": 3, "color": { "mode": "fixed", "fixedColor": "purple" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$job\", http_route=~\"$route\"}[$__rate_interval])))"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Active connections",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 5, "w": 4, "x": 12, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "area"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(kestrel_active_connections{job=\"$job\"})"
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Instances up",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 5, "w": 4, "x": 16, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "short", "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "count(count by (instance) (http_server_request_duration_seconds_count{job=\"$job\"}))"
        }
      ]
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Uptime",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 5, "w": 4, "x": 20, "y": 1 },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none"
      },
      "fieldConfig": {
        "defaults": { "unit": "s", "color": { "mode": "fixed", "fixedColor": "text" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "max(dotnet_process_cpu_time_seconds_total{job=\"$job\"}) or vector(0)"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Request rate by route",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean", "max"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum by (http_route) (rate(http_server_request_duration_seconds_count{job=\"$job\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{http_route}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Latency percentiles",
      "description": "Click a spike: exemplars carry trace_id and jump straight into Tempo.",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$job\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p50",
          "exemplar": true
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$job\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p95",
          "exemplar": true
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{job=\"$job\", http_route=~\"$route\"}[$__rate_interval])))",
          "legendFormat": "p99",
          "exemplar": true
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Responses by status code",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "bars", "lineWidth": 0, "fillOpacity": 80, "stacking": { "mode": "normal", "group": "A" } }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum by (http_response_status_code) (rate(http_server_request_duration_seconds_count{job=\"$job\", http_route=~\"$route\"}[$__rate_interval]))",
          "legendFormat": "{{http_response_status_code}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Outbound HTTP (dependencies)",
      "description": "http.client.* — every call this service makes to something else.",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum by (server_address) (rate(http_client_request_duration_seconds_count{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{server_address}}"
        }
      ]
    },
    {
      "id": 200,
      "type": "row",
      "title": "Runtime",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "CPU",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum by (instance) (rate(dotnet_process_cpu_time_seconds_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Managed heap",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 7, "w": 8, "x": 8, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum by (dotnet_gc_heap_generation) (dotnet_gc_last_collection_heap_size_bytes{job=\"$job\"})",
          "legendFormat": "gen {{dotnet_gc_heap_generation}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(dotnet_process_memory_working_set_bytes{job=\"$job\"})",
          "legendFormat": "working set"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "GC collections & thread pool",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 7, "w": 8, "x": 16, "y": 23 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum by (dotnet_gc_heap_generation) (rate(dotnet_gc_collections_total{job=\"$job\"}[$__rate_interval]))",
          "legendFormat": "gc gen {{dotnet_gc_heap_generation}} /s"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(dotnet_thread_pool_thread_count{job=\"$job\"})",
          "legendFormat": "threadpool threads"
        },
        {
          "refId": "C",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum(dotnet_thread_pool_queue_length{job=\"$job\"})",
          "legendFormat": "threadpool queue"
        }
      ]
    },
    {
      "id": 300,
      "type": "row",
      "title": "Traces & logs",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 30 },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "Span rate by operation (from Tempo metrics-generator)",
      "description": "These series exist without the app exporting a single metric — Tempo derives them from spans.",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "calcs": ["mean"], "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"$job\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "Span errors",
      "datasource": { "type": "prometheus", "uid": "${prometheus}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": { "mode": "fixed", "fixedColor": "red" },
          "custom": { "drawStyle": "bars", "lineWidth": 0, "fillOpacity": 80 }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "${prometheus}" },
          "expr": "sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"$job\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
          "legendFormat": "{{span_name}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "logs",
      "title": "Service logs",
      "description": "OTLP logs land with service_name; stdout logs land with app/container labels. This panel reads the OTLP stream.",
      "datasource": { "type": "loki", "uid": "${loki}" },
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 39 },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "loki", "uid": "${loki}" },
          "expr": "{service_name=\"$job\"} or {app=\"$job\"}",
          "maxLines": 500
        }
      ]
    }
  ]
}
